# Keep repository history, local data, exports and development artifacts out of images.
.git
**/.git
node_modules
**/node_modules
__pycache__
**/__pycache__
*.pyc
data
*.sqlite
**/*.sqlite
*.sqlite3
**/*.sqlite3
*.db
**/*.db
*.dump
**/*.dump
*.bak
**/*.bak
*.zip
**/*.zip
# Browser exports can have arbitrary names and contain private records.
# There are currently no tracked JSON assets; explicitly allowlist any needed in future.
*.json
**/*.json
.env
.env.*
**/.env
**/.env.*
*.pem
**/*.pem
*.key
**/*.key
*.jks
**/*.jks
*.keystore
**/*.keystore
*.p12
**/*.p12
plan-verification
today-verification
visual-results
